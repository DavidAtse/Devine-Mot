# =============================================
# .gitignore — DevineMot CI
# =============================================

# Clés VAPID privées (NE JAMAIS pousser sur Git !)
/keys/vapid_private.pem
/keys/

# Fichiers de config locaux
*.env
.env.local
.env.production

# Données d'export de la base (peuvent contenir des mots de passe hashés)
railway_import.sql
jeu_mot.sql
*.sql.bak

# Documents Word / PDF générés
*.docx
*.pdf

# Fichiers de développement Next.js / style-generation
/style-generation/

# Fichiers de cache Composer
/vendor/
composer.lock

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Fichiers Claude/Gemini
.claude/
.gemini/

# Données locales
/data/historique.json
/data/mot.txt
